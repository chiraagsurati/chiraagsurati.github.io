<?xml version='1.0' encoding='utf-8'?>
<widget id="com.chiraagsurati.arrowpuzzle" version="2.0.4" android-versionCode="47" xmlns="http://w3.org" xmlns:cdv="http://apache.org" xmlns:android="http://android.com">
    <name>Arrow : Puzzle Game</name>
    <description>
        A sample Apache Cordova application that responds to the deviceready event.
    </description>
    <author email="chirag.surati96@gmail.com" href="https://github.com/chiraagsurati">
        chirag surati
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <access origin="*" />
    <icon src="icon.png" />

    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="Orientation" value="portrait" />

    <platform name="android">
        <edit-config file="app/src/main/AndroidManifest.xml" target="/manifest/application" mode="merge">
            <application android:enableOnBackInvokedCallback="false" />
        </edit-config>
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        </config-file>
    </platform>

    <plugin name="cordova-plugin-local-notification" spec="^1.2.3" />
</widget>